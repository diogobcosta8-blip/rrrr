/* RESET DE ESTILOS BÁSICO */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #0d1117;
  color: #e6edf3;
  line-height: 1.6;
}

/* CABEÇALHO */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 8%;
  background-color: rgba(13, 17, 23, 0.95);
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid #30363d;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
  color: #58a6ff;
}

nav a {
  color: #c9d1d9;
  text-decoration: none;
  margin-left: 20px;
  transition: color 0.3s;
}

nav a:hover {
  color: #58a6ff;
}

/* HERO */
.hero {
  text-align: center;
  padding: 100px 20px;
  background: linear-gradient(180deg, #161b22 0%, #0d1117 100%);
}

.hero h1 {
  font-size: 2.8rem;
  margin-bottom: 20px;
  color: #ffffff;
}

.hero p {
  font-size: 1.2rem;
  color: #8b949e;
  max-width: 700px;
  margin: 0 auto 30px auto;
}

/* BOTÕES */
.btn-principal {
  display: inline-block;
  background-color: #238636;
  color: #ffffff;
  padding: 12px 28px;
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  font-weight: bold;
  cursor: pointer;
  text-decoration: none;
  transition: background-color 0.3s;
}

.btn-principal:hover {
  background-color: #2ea043;
}

.btn-card {
  width: 100%;
  margin-top: 20px;
  background-color: #21262d;
  color: #58a6ff;
  border: 1px solid #30363d;
  padding: 10px;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s;
}

.btn-card:hover {
  background-color: #58a6ff;
  color: #ffffff;
}

/* PRODUTOS */
.produtos-section {
  padding: 80px 8%;
  text-align: center;
}

.produtos-section h2 {
  font-size: 2rem;
  margin-bottom: 40px;
}

.cards-container {
  display: flex;
  flex-wrap: wrap;
  gap: 25px;
  justify-content: center;
}

.card {
  background-color: #161b22;
  border: 1px solid #30363d;
  border-radius: 8px;
  padding: 30px;
  flex: 1 1 300px;
  max-width: 360px;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.3s, border-color 0.3s;
}

.card:hover {
  transform: translateY(-6px);
  border-color: #58a6ff;
}

.card-tag {
  align-self: flex-start;
  background-color: rgba(88, 166, 255, 0.1);
  color: #58a6ff;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 0.8rem;
  margin-bottom: 15px;
  font-weight: bold;
}

.card h3 {
  font-size: 1.4rem;
  color: #ffffff;
}

.card h4 {
  font-size: 0.95rem;
  color: #8b949e;
  margin-bottom: 12px;
  font-weight: normal;
}

.card p {
  color: #c9d1d9;
  font-size: 0.95rem;
}

/* DIFERENCIAIS */
.diferenciais-section {
  background-color: #161b22;
  padding: 70px 8%;
  text-align: center;
  border-top: 1px solid #30363d;
  border-bottom: 1px solid #30363d;
}

.diferenciais-section h2 {
  margin-bottom: 40px;
}

.diferenciais-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  justify-content: center;
}

.item-diferencial {
  flex: 1 1 250px;
  max-width: 320px;
}

.item-diferencial span {
  font-size: 2.5rem;
}

.item-diferencial h3 {
  margin: 10px 0;
  color: #ffffff;
}

.item-diferencial p {
  color: #8b949e;
}

/* FORMULÁRIO */
.formulario-section {
  padding: 80px 20px;
  text-align: center;
}

.formulario-section h2 {
  margin-bottom: 10px;
}

.formulario-section p {
  color: #8b949e;
  margin-bottom: 30px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 15px;
  max-width: 420px;
  margin: 0 auto;
}

form input, form select {
  padding: 12px 16px;
  border-radius: 6px;
  border: 1px solid #30363d;
  background-color: #161b22;
  color: #ffffff;
  font-size: 1rem;
}

form input:focus, form select:focus {
  outline: 1px solid #58a6ff;
}

#mensagem-sucesso {
  margin-top: 20px;
  padding: 15px;
  background-color: #238636;
  color: #ffffff;
  border-radius: 6px;
  max-width: 420px;
  margin-left: auto;
  margin-right: auto;
}

.hidden {
  display: none;
}

/* RODAPÉ */
footer {
  text-align: center;
  padding: 30px 20px;
  border-top: 1px solid #30363d;
  color: #8b949e;
  font-size: 0.9rem;
}

/* DESIGN RESPONSIVO PARA DISPOSITIVOS MÓVEIS */
@media (max-width: 768px) {
  header {
    flex-direction: column;
    gap: 15px;
  }

  nav a {
    margin: 0 8px;
  }

  .hero h1 {
    font-size: 2rem;
  }
}
